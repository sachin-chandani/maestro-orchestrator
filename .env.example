# Copy to .env and fill in your own values. Never commit .env.

# Where data lives. The Docker image sets this to /data/maestro.db.
# MAESTRO_DB=~/.maestro/maestro.db

# Your timezone (IANA name). Defaults to the system timezone, which is UTC inside Docker,
# so set this when self-hosting or "5pm" will mean 5pm UTC.
# MAESTRO_TIMEZONE=Asia/Kolkata

# Required when the server listens on anything other than localhost (always true in Docker).
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
MAESTRO_API_TOKEN=

# Rate limits per client (0 = off): webhook requests with a bad signature, and wrong API tokens before
# a lockout. Genuinely signed webhooks and requests without a token are never counted.
# Behind a reverse proxy set MAESTRO_TRUST_PROXY_HEADERS=true so limits apply per real client.
# MAESTRO_RATE_LIMIT_WEBHOOK=60
# MAESTRO_RATE_LIMIT_AUTH_FAILURES=10
# MAESTRO_TRUST_PROXY_HEADERS=false

# Logs: text (default) or json; level DEBUG/INFO/WARNING
# MAESTRO_LOG_FORMAT=json
# MAESTRO_LOG_LEVEL=INFO

# Escalation for unacknowledged reminders: <delay>=<channel>[+<channel>], increasing delays under 12h
# MAESTRO_ESCALATION=10m=twilio_sms, 30m=telegram+twilio_sms

# Comma-separated delivery channels: console, macos, ntfy, twilio_sms, telegram, email
MAESTRO_CHANNELS=console

# ntfy push notifications (https://ntfy.sh or your own server)
NTFY_URL=https://ntfy.sh
NTFY_TOPIC=

# Telegram: create a bot with @BotFather and paste its token. Start Maestro, send /start to your bot,
# and it replies with your chat id. Only that chat can use the bot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Public address of this server, used to verify inbound webhooks (Twilio) behind a reverse proxy
# MAESTRO_PUBLIC_URL=https://maestro.example.com

# Reminder emails (the `email` channel). SMTP_SECURITY: starttls (default, port 587), ssl (465) or none.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=maestro@example.com
# MAESTRO_EMAIL_TO=you@example.com

# Email-in: a dedicated inbox polled over IMAP. Only MAESTRO_EMAIL_FROM senders, verified by DMARC.
# IMAP_HOST=imap.example.com
# IMAP_PORT=993
# IMAP_USER=maestro@example.com
# IMAP_PASSWORD=
# IMAP_FOLDER=INBOX
# MAESTRO_EMAIL_FROM=you@example.com
# First word of the Authentication-Results header your provider adds (check any received mail's headers)
# MAESTRO_EMAIL_AUTHSERV_ID=mx.google.com
# MAESTRO_EMAIL_POLL_SECONDS=60
# MAESTRO_EMAIL_REQUIRE_DMARC=true

# Twilio SMS to and from your own phone, and voice capture. Point the number's webhooks at
# <MAESTRO_PUBLIC_URL>/webhooks/twilio/sms (messaging) and <MAESTRO_PUBLIC_URL>/webhooks/twilio/voice (calls)

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
MAESTRO_SMS_TO=
